# Local development variables for infra/docker-compose.yml.
# Copy to infra/.env (gitignored) and change the passwords. Compose refuses
# to start if a required (*) variable is missing.
#
# The roles are created by postgres/init/01-roles.sh only on the first start
# of an empty postgres volume. Changing a password here afterwards does NOT
# change it in the database: run `pnpm db:down -v` to wipe and re-create.

# --- Postgres ---------------------------------------------------------------
# (*) Bootstrap superuser `postgres`. Only for the init script and emergencies;
#     nothing in the app connects as it.
POSTGRES_PASSWORD=change-me-superuser
# Database the app uses, owned by bhojnalya_owner.
DB_NAME=bhojnalya
# Host port (bound to 127.0.0.1) that postgres is published on.
POSTGRES_PORT=5432

# (*) bhojnalya_owner: migration owner, owns the database and every table.
DB_OWNER_PASSWORD=change-me-owner
# (*) app_user: what the API connects as. No BYPASSRLS, owns nothing.
APP_USER_PASSWORD=change-me-app
# (*) platform_admin: BYPASSRLS, for the audited cross-tenant module only.
PLATFORM_ADMIN_PASSWORD=change-me-platform-admin

# --- Caddy ------------------------------------------------------------------
# Host port (bound to 127.0.0.1) that Caddy's HTTP listener is published on.
CADDY_HTTP_PORT=8080

# --- Connection strings for tools run on the host (drizzle-kit, psql) -------
# Compose does not use these; the api container builds its own with host
# `postgres`. Keep the passwords and port in step with the values above.
DATABASE_URL=postgres://app_user:change-me-app@127.0.0.1:5432/bhojnalya
MIGRATION_DATABASE_URL=postgres://bhojnalya_owner:change-me-owner@127.0.0.1:5432/bhojnalya
PLATFORM_ADMIN_DATABASE_URL=postgres://platform_admin:change-me-platform-admin@127.0.0.1:5432/bhojnalya
