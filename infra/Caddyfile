# Local dev reverse proxy (TRD §15.2). Production adds the site address and
# TLS; the routes stay the same. Frontends run on their own Vite dev servers.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# REST under /api/v1, the Socket.io transport (incl. websocket upgrade),
	# and the uptime check the API serves at the root (TRD §16).
	@api path /api /api/* /socket.io /socket.io/* /healthz
	handle @api {
		reverse_proxy api:3000
	}

	handle {
		respond "bhojnalya: no route" 404
	}
}
